{
	"extends": "@arcmantle/tsconfig",
	"compilerOptions": {
		"rootDir": ".",
		"baseUrl": ".",
		"checkJs": true,
		"allowJs": true,
		"isolatedDeclarations": false,
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"tests/**/*.ts",
		"tests/**/*.d.ts"
	],
	"exclude": [
		"node_modules"
	]
}
