{
	"name": "@arcmantle/lit-jsx",
	"version": "1.0.0",
	"description": "A JSX runtime and compiler that transforms JSX into Lit templates.",
	"repository": {
		"type": "git",
		"url": "https://github.com/arcmantle/lit-jsx.git"
	},
	"license": "Apache-2.0",
	"author": "Kristoffer Roen-Lie",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/utils.js",
		"./jsx-runtime": "./src/shared/jsx-types.ts",
		"./jsx-dev-runtime": "./src/shared/jsx-types.ts",
		"./vite": "./dist/compiler/vite-plugin.js"
	},
	"main": "./dist/react-jsx/jsx-runtime.js",
	"types": "./dist/shared/jsx-types.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "rimraf dist && tsc --project ./src/tsconfig.json",
		"dev": "vite build --watch --mode=development",
		"docs:build": "typedoc --options docs/typedoc.json && vitepress build docs",
		"docs:dev": "vitepress dev docs",
		"docs:preview": "vitepress preview docs",
		"docs:typedoc": "typedoc --options docs/typedoc.json",
		"test": "pnpm vitest run"
	},
	"dependencies": {
		"@babel/core": "catalog:lit",
		"@babel/plugin-syntax-jsx": "catalog:lit",
		"@babel/traverse": "catalog:lit",
		"@babel/types": "catalog:lit",
		"@types/babel__core": "catalog:lit",
		"@types/babel__traverse": "catalog:lit",
		"csstype": "catalog:lit",
		"deepmerge-ts": "catalog:lit",
		"lit-html": "catalog:lit",
		"oxc-resolver": "catalog:lit",
		"validate-html-nesting": "catalog:lit"
	},
	"devDependencies": {
		"@types/node": "catalog:lit",
		"oxc-parser": "catalog:lit",
		"oxc-walker": "catalog:lit",
		"typedoc": "catalog:lit",
		"typedoc-plugin-markdown": "catalog:lit",
		"typescript": "catalog:lit",
		"vite": "catalog:lit",
		"vitepress": "catalog:lit",
		"vitest": "catalog:lit"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	}
}
