{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"types": [
			"node"
		],
		"rootDir": ".",
		"outDir": "../dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": false,
		"noEmitOnError": true
	},
	"include": [
		"./**/*.ts"
	]
}