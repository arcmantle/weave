{
	"name": "css-literal-intellisense",
	"displayName": "CSS Literal IntelliSense",
	"version": "0.0.5",
	"description": "CSS IntelliSense, completion, hover, diagnostics, and syntax highlighting inside css`` tagged templates and /*css*/ annotated template literals.",
	"categories": [
		"Programming Languages",
		"Linters"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/arcmantle/weave"
	},
	"license": "MIT",
	"publisher": "arcmantle",
	"type": "module",
	"main": "./dist/extension.mjs",
	"scripts": {
		"compile": "tsc -p ./ --noEmit && vite build --config vite.build.config.ts",
		"package": "pnpm run compile && pnpx @vscode/vsce package --allow-missing-repository --no-dependencies",
		"test": "vitest run",
		"watch": "tsc -watch -p ./"
	},
	"contributes": {
		"configuration": {
			"title": "CSS Literal IntelliSense",
			"properties": {
				"cssLiteralIntellisense.tagNames": {
					"type": "array",
					"default": [
						"css"
					],
					"items": {
						"type": "string"
					},
					"description": "Tag function names to treat as CSS template literals."
				},
				"cssLiteralIntellisense.commentMarkers": {
					"type": "array",
					"default": [
						"css"
					],
					"items": {
						"type": "string"
					},
					"description": "Comment markers (e.g. /*css*/) that indicate a following template literal contains CSS."
				},
				"cssLiteralIntellisense.validate": {
					"type": "boolean",
					"default": true,
					"description": "Enable or disable CSS diagnostics inside template literals."
				}
			}
		},
		"grammars": [
			{
				"scopeName": "inline.css.tagged-template",
				"path": "./syntaxes/css-tagged-template.json",
				"injectTo": [
					"source.ts",
					"source.js",
					"source.tsx",
					"source.jsx"
				],
				"embeddedLanguages": {
					"meta.embedded.block.css": "css"
				}
			}
		]
	},
	"activationEvents": [
		"onLanguage:typescript",
		"onLanguage:javascript",
		"onLanguage:typescriptreact",
		"onLanguage:javascriptreact"
	],
	"dependencies": {
		"vscode-css-languageservice": "^6.3.0",
		"vscode-languageserver-textdocument": "^1.0.0",
		"vscode-languageserver-types": "^3.17.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.85.0",
		"typescript": "^5.7.0",
		"vite": "8.0.0-beta.16",
		"vitest": "^3.0.0"
	},
	"engines": {
		"vscode": "^1.85.0"
	}
}
