{
	"scopeName": "inline.css.tagged-template",
	"injectionSelector": "L:source.ts, L:source.tsx, L:source.js, L:source.jsx",
	"patterns": [
		{ "include": "#css-tagged-template" },
		{ "include": "#css-comment-template" }
	],
	"repository": {
		"css-tagged-template": {
			"comment": "Matches css`...` tagged template literals",
			"begin": "(?i)\\b(css)\\s*(`)",
			"beginCaptures": {
				"1": { "name": "entity.name.function.tagged-template.css" },
				"2": { "name": "punctuation.definition.string.template.begin.js" }
			},
			"end": "(`)",
			"endCaptures": {
				"1": { "name": "punctuation.definition.string.template.end.js" }
			},
			"contentName": "meta.embedded.block.css",
			"patterns": [
				{ "include": "#template-interpolation" },
				{ "include": "source.css" }
			]
		},
		"css-comment-template": {
			"comment": "Matches /*css*/ `...` or /* css */ `...` annotated template literals",
			"begin": "(?:/\\*\\*?\\s*\\??\\s*css\\s*\\*/|//\\s*css)\\s*(`)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.string.template.begin.js" }
			},
			"end": "(`)",
			"endCaptures": {
				"1": { "name": "punctuation.definition.string.template.end.js" }
			},
			"contentName": "meta.embedded.block.css",
			"patterns": [
				{ "include": "#template-interpolation" },
				{ "include": "source.css" }
			]
		},
		"template-interpolation": {
			"begin": "\\$\\{",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.template-expression.begin.js" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.definition.template-expression.end.js" }
			},
			"contentName": "meta.template.expression.js",
			"patterns": [
				{ "include": "source.ts" }
			]
		}
	}
}
