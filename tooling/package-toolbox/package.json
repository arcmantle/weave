		"semver": "catalog:",
		"tslib": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"yargs": "catalog:"
	},
	"devDependencies": {
		"@arcmantle/vite-lib-config": "workspace:*",
		"@types/fs-extra": "catalog:",
		"@types/semver": "catalog:",
		"@types/yargs": "catalog:"
	},
	"engines": {
		"node": ">=22"
	}
}
