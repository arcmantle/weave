{
	"name": "yeetm",
	"version": "2.0.3",
	"description": "Recursively find and remove directories by name. Defaults to node_modules. Fast, safe, satisfying.",
	"keywords": [
		"node_modules",
		"clean",
		"remove",
		"delete",
		"purge",
		"disk-space",
		"cli",
		"devtools"
	],
	"homepage": "https://github.com/arcmantle/weave/tree/main/tooling/yeetm#readme",
	"bugs": {
		"url": "https://github.com/arcmantle/weave/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/arcmantle/weave.git",
		"directory": "tooling/yeetm"
	},
	"license": "MIT",
	"author": "Kristoffer Roen-Lie",
	"type": "module",
	"bin": {
		"yeetm": "./bin/yeetm.js"
	},
	"files": [
		"bin",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "go run build.go",
		"postinstall": "node ./bin/postinstall.js"
	},
	"optionalDependencies": {
		"@arcmantle/yeetm-darwin-arm64": "2.0.3",
		"@arcmantle/yeetm-darwin-x64": "2.0.3",
		"@arcmantle/yeetm-linux-arm64": "2.0.3",
