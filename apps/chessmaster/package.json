{
	"name": "@arcmantle/mirage-chess-master",
	"version": "1.0.0",
	"description": "Mirage project",
	"keywords": [
		"web",
		"components",
		"web-components",
		"typescript",
		"lib"
	],
	"author": "Kristoffer Roen-Lie",
	"type": "module",
	"main": "./dist/lib/index.js",
	"typings": "./dist/lib/index.d.ts",
	"files": [
		"LICENSE",
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"clean": "rimraf node_modules dist *.tsbuildinfo",
		"clean:dist": "rimraf dist *.tsbuildinfo",
		"clean:node": "rimraf node_modules",
		"clean:vite": "rimraf node_modules/.vite",
		"dev": "vite",
		"package": "npm run build && npm run package:move",
		"package:move": "node --no-warnings --experimental-modules --loader tsm ./scripts/move-output.ts --color",
		"preview": "vite preview --mode preview",
		"test": "vitest"
	},
	"dependencies": {
		"@floating-ui/dom": "catalog:",
		"@lit-labs/context": "catalog:",
		"@lit-labs/virtualizer": "catalog:",
		"lit": "catalog:",
		"nanoid": "catalog:",
		"ts-pattern": "catalog:",
		"tslib": "catalog:"
	},
	"devDependencies": {
		"@types/sharedworker": "catalog:",
		"bootstrap-icons": "catalog:",
		"rimraf": "catalog:",
		"ts-toolbelt": "catalog:",
		"type-fest": "catalog:"
	},
	"engines": {
		"node": ">=22"
	}
}
