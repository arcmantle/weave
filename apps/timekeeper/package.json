{
	"name": "@arcmantle/mirage",
	"version": "1.0.0",
	"description": "Mirage project",
	"keywords": [
		"web",
		"components",
		"web-components",
		"typescript",
		"lib"
	],
	"author": "Kristoffer Roen-Lie",
	"type": "module",
	"main": "./dist/lib/index.js",
	"typings": "./dist/lib/index.d.ts",
	"files": [
		"LICENSE",
		"/src/**/*.ts",
		"/dist/lib/*",
		"/dist/assets/*"
	],
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"package": "npm run build && npm run package:move",
		"package:move": "node --no-warnings --experimental-modules --loader tsm ./scripts/move-output.ts --color"
	},
	"dependencies": {
		"@floating-ui/dom": "catalog:",
		"@lit-labs/context": "catalog:",
		"@lit-labs/virtualizer": "catalog:",
		"lit": "catalog:",
		"tslib": "catalog:"
	},
	"devDependencies": {
		"@types/sharedworker": "catalog:",
		"rimraf": "catalog:",
		"ts-toolbelt": "catalog:",
		"type-fest": "catalog:"
	},
	"engines": {
		"node": ">=22"
	}
}
