{
	"name": "@arcmantle/pivot-client-plugin",
	"version": "1.0.0",
	"description": "Runtime API for Pivot client-side plugins. Provides types, context, and helpers for plugin authors.",
	"license": "Apache-2.0",
	"author": "Kristoffer Roen-Lie",
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"scripts": {
		"build": "rimraf dist && tsc --project ./src/tsconfig.json",
		"dev": "tsc --project ./src/tsconfig.json --watch"
	},
	"dependencies": {
		"@arcmantle/injector": "catalog:",
		"@arcmantle/pivot-client-router": "workspace:*",
		"lit": "catalog:",
		"tslib": "catalog:"
	}
}
