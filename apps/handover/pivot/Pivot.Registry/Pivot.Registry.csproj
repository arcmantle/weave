<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RazorLangVersion>Latest</RazorLangVersion>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Minio" Version="6.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pivot.Auth\Pivot.Auth.csproj" />
    <ProjectReference Include="..\Pivot.Core\Pivot.Core.csproj" />
  </ItemGroup>

  <!-- Build the Lit/TypeScript client during build -->
  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)\..\Pivot.Registry.Client</ClientDir>
    <ClientPublishDir>$(ClientDir)\dist</ClientPublishDir>
    <WwwRootDir>$(MSBuildProjectDirectory)\wwwroot</WwwRootDir>
    <SkipClientBuild>false</SkipClientBuild>
  </PropertyGroup>

  <Target Name="BuildClient" BeforeTargets="Build" Condition="Exists('$(ClientDir)') And '$(SkipClientBuild)' != 'true'">
    <Message Text="Building Lit client..." Importance="high" />
    <Exec Command="pnpm install" WorkingDirectory="$(ClientDir)" />
    <Exec Command="pnpm build" WorkingDirectory="$(ClientDir)" />

    <!-- Copy built client to wwwroot -->
    <RemoveDir Directories="$(WwwRootDir)" />
    <MakeDir Directories="$(WwwRootDir)" />
    <ItemGroup>
      <ClientFiles Include="$(ClientPublishDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientFiles)" DestinationFolder="$(WwwRootDir)\%(RecursiveDir)" />
    <Message Text="Copied client files to wwwroot" Importance="high" />
  </Target>

  <!-- Include client build output in publish and NuGet package -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToPublishDirectory="PreserveNewest" PackagePath="contentFiles\any\any\wwwroot;content\wwwroot" Pack="true" />
  </ItemGroup>

</Project>
