@page "/login"
@using Pivot.Registry.Client.Services
@inject AuthenticationService AuthService
@inject NavigationManager Navigation

<div class="login-container">
    <div class="login-box">
        <h1>Pivot Registry Login</h1>
        <p class="login-subtitle">Enter your username to continue</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="login-form">
            <div class="form-group">
                <label for="username">Username</label>
                <input
                    id="username"
                    type="text"
                    class="form-control"
                    @bind="username"
                    @bind:event="oninput"
                    @onkeypress="HandleKeyPress"
                    placeholder="Enter your username"
                    autofocus />
            </div>

            <button class="btn btn-primary btn-block" @onclick="HandleLogin" disabled="@isLoggingIn">
                @if (isLoggingIn)
                {
                    <span>Logging in...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string errorMessage = "";
    private bool isLoggingIn = false;

    private async Task HandleLogin()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(username))
        {
            errorMessage = "Please enter a username";
            return;
        }

        try
        {
            isLoggingIn = true;
            var result = await AuthService.LoginAsync(username.Trim());

            if (result.Success)
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = result.Error ?? "Login failed";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            isLoggingIn = false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }
}
