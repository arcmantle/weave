<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Copy manifest to output directory -->
		<None Include="../plugin.json" CopyToOutputDirectory="PreserveNewest" Link="plugin.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- Framework reference - host provides this, don't bundle -->
		<ProjectReference Include="../../../../Pivot.Core/Pivot.Core.csproj" Private="false" />
		<!-- Plugin dependency - for IntelliSense only, don't bundle -->
		<ProjectReference Include="../../UsersPlugin/server/UsersPlugin.csproj" Private="false" />
	</ItemGroup>
</Project>
