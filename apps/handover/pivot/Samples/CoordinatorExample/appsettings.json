{
  "$schema": "../../pivot-schema.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApplicationName": "CoordinatorExample",
  "AllowedHosts": "*",
