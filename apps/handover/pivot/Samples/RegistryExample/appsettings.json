{
	"$schema": "./pivot-schema.json",
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"Urls": "http://localhost:5100",
	"Pivot": {
		"Registry": {
			"AccessMode": "Public",
			"Enabled": true,
			"ApplicationName": "RegistryExample",
			"StorageProvider": "FileSystem"
		}
	}
}
