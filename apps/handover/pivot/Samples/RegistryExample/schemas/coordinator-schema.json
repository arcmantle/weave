{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "PluginManagementOptions",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Enabled": {
      "type": "boolean"
    },
    "ConnectionString": {
      "type": "string"
    },
    "PluginRepositoryDirectory": {
      "type": [
        "null",
        "string"
      ]
    },
    "ActivePluginsDirectory": {
      "type": [
        "null",
        "string"
      ]
    },
    "AutoDisableOnFailure": {
      "type": "boolean"
    },
    "RecentlyModifiedWindowMinutes": {
      "type": "integer",
      "format": "int32"
    }
  }
}