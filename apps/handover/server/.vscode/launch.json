{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Coordinator",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/Coordinator/bin/Debug/net9.0/Coordinator.dll",
			"args": [],
			"cwd": "${workspaceFolder}/Coordinator",
			"stopAtEntry": false,
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			},
			"symbolOptions": {
				"searchPaths": [
					"${workspaceFolder}/Server/bin/Deployments",
					"${workspaceFolder}/Plugins/Users/bin/Debug/net9.0"
				],
				"searchMicrosoftSymbolServer": false
			},
			"sourceFileMap": {
				"/build/": "${workspaceFolder}/"
			},
			"justMyCode": false
		},
		{
			"name": "Launch Proxy",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/Proxy/bin/Debug/net9.0/Proxy.dll",
			"args": [],
			"cwd": "${workspaceFolder}/Proxy",
			"stopAtEntry": false,
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			}
		},
		{
			"name": "Attach to Backend Server",
			"type": "coreclr",
			"request": "attach",
			"processId": "${command:pickProcess}",
			"symbolOptions": {
				"searchPaths": [
					"${workspaceFolder}/Plugins/Users/bin/Debug/net9.0",
					"${workspaceFolder}/Plugins",
					"${workspaceFolder}/Server/bin/Deployments"
				],
				"searchMicrosoftSymbolServer": false
			},
			"sourceFileMap": {
				"/build/": "${workspaceFolder}/"
			},
			"justMyCode": false
		},
		{
			"name": "Debug Server (Simple - No Hot Reload)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build-server-and-plugins",
			"program": "${workspaceFolder}/Server/bin/Debug/net9.0/Server.dll",
			"args": [],
			"cwd": "${workspaceFolder}/Server",
			"stopAtEntry": false,
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"ASPNETCORE_URLS": "http://localhost:5001"
			},
			"sourceFileMap": {
				"/Views": "${workspaceFolder}/Views"
			}
		}
	],
	"compounds": [
		{
			"name": "Handover System (Coordinator + Proxy)",
			"configurations": ["Launch Coordinator", "Launch Proxy"],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "Handover",
				"order": 1
			}
		},
		{
			"name": "🔥 Full System with Hot Reload (Debug)",
			"configurations": [
				"Launch Coordinator",
				"Launch Proxy"
			],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "Handover",
				"order": 2
			},
			"preLaunchTask": "build-plugins"
		}
	]
}
