{
	"name": "pivot-auto-attach",
	"displayName": "Pivot Auto-Attach Debugger",
	"version": "0.0.1",
	"description": "Automatically attaches debugger to Pivot backend Server.dll processes",
	"categories": [
		"Debuggers"
	],
	"main": "./out/extension.js",
	"scripts": {
		"compile": "tsc -p ./ && pnpx @vscode/vsce package --allow-missing-repository",
		"lint": "eslint src --ext ts",
		"pretest": "npm run compile && npm run lint",
		"watch": "tsc -watch -p ./"
	},
	"contributes": {
		"commands": [
			{
				"command": "pivot-auto-attach.enable",
				"title": "Pivot: Enable Auto-Attach to Backend"
			},
			{
				"command": "pivot-auto-attach.disable",
				"title": "Pivot: Disable Auto-Attach to Backend"
			}
		],
		"configuration": {
			"title": "Pivot Auto-Attach",
			"properties": {
				"pivotAutoAttach.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable automatic debugger attachment to backend processes"
				},
				"pivotAutoAttach.processName": {
					"type": "string",
					"default": "Server.dll",
					"description": "Name of the DLL to watch for and attach to"
				},
				"pivotAutoAttach.symbolSearchPaths": {
					"type": "array",
					"default": [],
					"description": "Additional symbol search paths for debugging plugins"
				}
			}
		}
	},
	"activationEvents": [
		"onDebugResolve:coreclr"
	],
	"devDependencies": {
		"@types/node": "20.x",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^6.15.0",
		"@typescript-eslint/parser": "^6.15.0",
		"eslint": "^8.56.0",
		"typescript": "^5.3.3"
	},
	"engines": {
		"vscode": "^1.85.0"
	}
}
