<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Changelog.Storage</RootNamespace>
    <AssemblyName>Changelog.MongoDB</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Arcmantle</Authors>
    <Description>MongoDB storage provider for the Changelog library</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Changelog.Core\Changelog.csproj" />
  </ItemGroup>

</Project>
