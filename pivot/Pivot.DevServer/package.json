{
	"name": "@arcmantle/pivot-dev-server",
	"version": "1.0.0",
	"description": "Development server for Pivot applications. Serves the app shell and plugin source code with full HMR support.",
	"license": "Apache-2.0",
	"author": "Kristoffer Roen-Lie",
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"pivot-dev": "./dist/cli.js"
	},
	"files": [
		"dist",
		"app-shell",
		"README.md"
	],
	"scripts": {
		"build": "rimraf dist && tsc --project ./src/tsconfig.json",
		"dev": "tsc --project ./src/tsconfig.json --watch"
	},
	"dependencies": {
		"@arcmantle/injector": "workspace:*",
		"@arcmantle/pivot-client-auth": "workspace:*",
		"@arcmantle/pivot-client-plugin": "workspace:*",
		"@arcmantle/pivot-client-router": "workspace:*",
		"@lit/context": "catalog:",
		"lit": "catalog:",
		"tslib": "catalog:",
		"vite": "catalog:"
	},
	"devDependencies": {
		"@arcmantle/tsconfig": "workspace:^",
		"rimraf": "catalog:",
		"typescript": "catalog:"
	}
}
