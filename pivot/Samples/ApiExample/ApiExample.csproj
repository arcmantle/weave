<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<!-- Import local development plugin references if file exists (gitignored, Debug builds only) -->
	<Import
		Project="ApiExample.Local.props"
		Condition="Exists('ApiExample.Local.props') AND '$(Configuration)' == 'Debug'"
	/>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Pivot.Core\Pivot.Core.csproj" />
	</ItemGroup>

	<!-- Build the Pivot app shell into wwwroot/ on publish -->
	<Import Project="..\..\Pivot.Core\Build\Pivot.AppShell.targets" />

</Project>
