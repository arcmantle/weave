{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8080",
  "Pivot": {
    "Proxy": {
      "CoordinatorUrl": "http://localhost:5000",
      "HealthCheckIntervalSeconds": 5,
      "HealthCheckPath": "/health"
    }
  }
}
