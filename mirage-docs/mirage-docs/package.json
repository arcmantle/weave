{
	"name": "@arcmantle/mirage-docs",
	"version": "2.0.24",
	"description": "",
	"repository": {
		"type": "git",
		"url": "https://github.com/arcmantle/mirage-docs.git"
	},
	"license": "Apache-2.0",
	"author": "Kristoffer Roen-Lie",
	"sideEffects": [],
	"type": "module",
	"exports": {
		"./server": "./dist/server/index.js",
		"./app/*": "./dist/app/*",
		"./workers/*": "./dist/workers/*",
		"./assets/*": "./src/assets/*",
		"./aegis/*": "./src/app/aegis/*"
	},
	"main": "./dist/app/index.js",
	"types": "./dist/app/index.d.ts",
	"files": [
		"./dist",
		"./src",
		"./LICENSE",
		"./package.json",
		"./README.md"
	],
	"scripts": {
		"build": "pnpm run --sequential \"/^build:.+/\"",
		"build:server": "vite build --config ./vite.config.ts",
		"build:types": "tsc --project ./src/app/tsconfig.json && tsc --project ./src/server/tsconfig.json",
		"build:workers": "vite build --config ./vite-workers.config.ts",
		"merge-tsconfig": "pnpm run --sequential \"/^merge-tsconfig:.+/\"",
		"merge-tsconfig:1": "pkg-toolbox merge-tsconfig --config ./src/app/tsconfig.json",
		"merge-tsconfig:2": "pkg-toolbox merge-tsconfig --config ./src/server/tsconfig.json",
		"merge-tsconfig:3": "pkg-toolbox merge-tsconfig --config ./src/workers/tsconfig.json",
		"test": "vitest --config ./tests/vite.config.ts"
	},
	"dependencies": {
		"@arcmantle/adapter-element": "catalog:",
		"@arcmantle/injector": "catalog:",
		"@arcmantle/library": "catalog:",
		"@arcmantle/monaco-editor-wc": "workspace:^",
		"@arcmantle/vite-plugin-copy": "workspace:*",
		"@custom-elements-manifest/analyzer": "catalog:",
		"@orama/orama": "catalog:",
		"@orama/plugin-data-persistence": "catalog:",
		"@orama/plugin-match-highlight": "catalog:",
		"@orama/plugin-parsedoc": "catalog:",
		"@sindresorhus/slugify": "catalog:",
		"deepmerge-ts": "catalog:",
		"globby": "catalog:",
		"highlight.js": "catalog:",
		"markdown-it": "catalog:",
		"markdown-it-anchor": "catalog:",
		"mermaid": "catalog:",
		"tabbable": "catalog:",
		"tslib": "catalog:"
	},
	"devDependencies": {
		"@types/markdown-it": "catalog:",
		"@types/sharedworker": "catalog:"
	},
	"peerDependencies": {
		"lit": "catalog:",
		"vite": "catalog:"
	}
}
